<?xml version="1.0" encoding="utf-8"?>
<!-- Allow HTTP to PC LAN (eva-core :8787). Local-dev only — not for Play Store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
