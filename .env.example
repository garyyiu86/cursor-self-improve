# Create at https://cursor.com/dashboard/api
CURSOR_API_KEY=your_api_key_here

# Create at https://app.tavily.com (do not commit real keys)
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Chat LLM ----
# Hong Kong note: Gemini / Groq are often blocked.
# Prefer: openrouter (free) or deepseek. auto picks first available key.
# auto | openrouter | deepseek | gemini | groq | ollama
EVA_LLM=openrouter

# Chat backend: eva (local KB/Tavily/LLM) | tencent (Tencent Cloud ADP)
# Can also switch in the Eva UI dropdown.
# EVA_CHAT_MODE=eva

# Tencent Cloud Agent Development Platform (LKE ADP)
# POST https://wss.lke.tencentcloud.com/adp/v2/chat
TENCENT_LKE_APP_KEY=
TENCENT_LKE_VISITOR_ID=
# TENCENT_LKE_BASE_URL=https://wss.lke.tencentcloud.com
# TENCENT_LKE_TIMEOUT_MS=120000
# Optional: pin a conversation id (32-64 chars). Empty = persist locally.
# TENCENT_LKE_CONVERSATION_ID=
# Max KB/Tavily notes injected into SystemRole (prompt RAG)
# TENCENT_LKE_KB_MAX_CHARS=4000
# Optional: pick-file in chat for PDF/images (DescribeStorageCredential → COS).
# Text files (txt/md/csv/json) work with AppKey only.
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_LKE_BOT_BIZ_ID=
# Optional. Leave empty to auto-try ap-guangzhou / ap-hongkong / …
# TENCENT_LKE_REGION=ap-guangzhou
# EVA_CHAT_FILE_MAX_BYTES=8388608

# 1) OpenRouter free — https://openrouter.ai/keys  (works in most regions incl. HK)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=60000

# 2) DeepSeek — https://platform.deepseek.com/api_keys  (usually OK in HK; may need top-up)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_MS=60000

# 3) Gemini — often unavailable in HK
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# 4) Groq — site may be blocked
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# 5) Local Ollama fallback
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Idle gap between stream tokens (ms). Total wall clock is separate.
OLLAMA_TIMEOUT_MS=1800000
OLLAMA_TOTAL_TIMEOUT_MS=1800000
OLLAMA_KEEP_ALIVE=30m

EVA_USE_SEARCH=1
EVA_USE_KB=1
EVA_KB_MIN_SCORE=7
EVA_DATABASE_URL=postgres://eva:eva@127.0.0.1:5433/eva_kb
# Reply length (tokens). Too low → answers cut mid-sentence.
# EVA_LLM_MAX_TOKENS_FACT=480
# EVA_LLM_MAX_TOKENS_CHAT=280
# After fact chat: auto Tavily→KB related questions in background (default on)
EVA_KB_AUTO_WARMUP=1
EVA_KB_AUTO_WARMUP_MAX=3
EVA_KB_AUTO_WARMUP_DELAY_MS=1500
# 常識自問自答 → KB（npm run eva:self-drill）
# EVA_SELF_DRILL_LIMIT=10
# EVA_SELF_DRILL_GEN=5
# EVA_SELF_DRILL_BATCH=5
# EVA_SELF_DRILL_DELAY_MS=1200
# EVA_SELF_DRILL_ROUND_DELAY_MS=3000
# 出題用邊個 LLM（預設 ollama，避免雲端 402；可改 deepseek/openrouter）
# EVA_SELF_DRILL_LLM=ollama
# 自問自答引擎：eva（Tavily 查證）| tencent（ADP 出題+作答）
# EVA_SELF_DRILL_MODE=eva
# KB → LoRA JSONL（npm run eva:export-train）
# personal | mixed | kb（預設 personal＝偏人設／語氣）
# EVA_EXPORT_MODE=personal
# EVA_EXPORT_TRAIN_LIMIT=10000
# EVA_EXPORT_TRAIN_MIN_CHARS=12
# EVA_EXPORT_SELF_DRILL_ONLY=0
# EVA_EXPORT_INCLUDE_PERSONA=1
# EVA_EXPORT_CHAT_LIMIT=200
# EVA_EXPORT_PERSONAL_REPEAT=3
# EVA_EXPORT_KB_RATIO=0.25
# 每日 06:00 自動（npm run eva:schedule-train）
# EVA_DAILY_TRAIN_LORA=0
# EVA_DAILY_TRAIN_MIN_EXAMPLES=50
# EVA_DAILY_TRAIN_KB_UP=1
# EVA_DAILY_TRAIN_MAX_STEPS=60
# EVA_DAILY_TRAIN_PYTHON=
# EVA_DAILY_TRAIN_SCRIPT=
# LoRA CPU knobs (npm run eva:train-lora)
# EVA_LORA_BASE=Qwen/Qwen2.5-0.5B-Instruct
# EVA_LORA_THREADS=2
# EVA_LORA_MAX_SEQ=256
# EVA_LORA_LOW_PRIORITY=1
# 每日 21:00 KB backup + git commit / push（npm run eva:schedule-kb-backup）
EVA_KB_BACKUP_PUSH=1
EVA_KB_BACKUP_COMMIT=1
EVA_KB_BACKUP_KB_UP=0
# EVA_KB_BACKUP_RETRIES=12
# EVA_KB_BACKUP_RETRY_SEC=30
EVA_REPLY_LANGUAGE=zh-Hant
# File-watch auto restart. Set 1 so overlay relaunches when eva-core / .env / dist change.
EVA_AUTO_RELOAD=1

# Eva HTTP API (LAN mobile / headless chat)
EVA_API_TOKEN=change-me-local-token
EVA_API_PORT=8787
EVA_API_HOST=0.0.0.0
