# Create at https://cursor.com/dashboard/api
CURSOR_API_KEY=your_api_key_here

# Create at https://app.tavily.com (do not commit real keys)
TAVILY_API_KEY=your_tavily_api_key_here

# Local chatbot model (llama3.1:8b recommended for persona; qwen2.5:3b is lighter/faster)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Ollama request timeout (ms). 8B cold start can take 30–60s+.
OLLAMA_TIMEOUT_MS=180000

# Use Tavily web search to fill knowledge base misses (set 0 to disable)
EVA_USE_SEARCH=1
EVA_USE_KB=1
# Minimum KB match score before skipping Tavily (default 7)
EVA_KB_MIN_SCORE=7
# Optional second Ollama pass to rewrite canned tone (slower). Default off.
# EVA_VOICE_REWRITE=1

# Postgres knowledge base (replaces JSON file; no 200-entry cap)
# Docker default from docker-compose.yml:
EVA_DATABASE_URL=postgres://eva:eva@127.0.0.1:5433/eva_kb

# Reply language: auto | zh-Hant | zh-Hans | en  (default zh-Hant)
EVA_REPLY_LANGUAGE=zh-Hant

# Eva auto-restarts when overlay files / .env / package.json change (set 0 to disable)
EVA_AUTO_RELOAD=1
