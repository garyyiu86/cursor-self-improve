{
  "name": "cursor-self-improve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "overlay/boot.cjs",
  "scripts": {
    "test": "vitest run",
    "self-improve": "tsx --env-file=.env src/self-improve.ts",
    "typecheck": "tsc --noEmit",
    "overlay": "node overlay/scripts/run-overlay.cjs",
    "companion": "node overlay/scripts/run-overlay.cjs",
    "overlay:once": "electron .",
    "kb:up": "docker compose up -d",
    "kb:down": "docker compose down",
    "kb:init": "node overlay/scripts/init-kb-db.cjs",
    "kb:warmup": "node overlay/scripts/kb-warmup.cjs",
    "eva:server": "node eva-core/server.cjs",
    "eva:web:dev": "npm --prefix eva-web run dev",
    "eva:web:build": "npm --prefix eva-web run build",
    "eva:mobile:sync": "npm run eva:web:build && npm --prefix eva-mobile run sync",
    "eva:mobile:open": "npm --prefix eva-mobile run open:android",
    "eva:verify": "node scripts/verify-eva-api.cjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "opencc-js": "^1.4.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^43.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
